# ── Database (Supabase) ──────────────────────────────────────────────────────
# Get from: Supabase → Settings → Database → Connection string → URI
# IMPORTANT: append ?sslmode=require for Supabase
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: https://your-railway-api.railway.app/auth/github/callback
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Pinned scoring model. Changing this changes how every candidate is graded —
# bump RUBRIC_VERSION in src/config/scoring.ts at the same time so old and new
# scores are never compared as like-for-like. Leave unset to use the default.
# SCORING_MODEL="claude-sonnet-4-6"

# Model used for QUESTION generation only (never for scoring). Defaults to
# SCORING_MODEL.
# QUESTION_MODEL="claude-sonnet-4-6"

# Sampling temperature for question generation. Deliberately NOT 0: a candidate
# resuming an abandoned verbal step must not be handed back the identical
# question they already saw and had time to prepare. Scoring is always 0.
# QUESTION_TEMPERATURE=1

# Cheaper model used ONLY when question generation exhausts its retries.
# Scoring NEVER falls back — it retries, then fails loudly.
# FALLBACK_MODEL="claude-haiku-4-5-20251001"

# Throughput ceiling against your Anthropic tier. IMPORTANT: set ANTHROPIC_RPM
# to match your actual account limit — this is what died during DevFest.
# Each submission issues 3 parallel scoring calls, so the queue limiter is
# derived as RPM/3 jobs per minute.
# ANTHROPIC_RPM=20
# ANTHROPIC_CONCURRENCY=2
# Attempts per individual Anthropic call before giving up (backoff + jitter).
# ANTHROPIC_MAX_RETRIES=5

# ── GitHub Webhook ───────────────────────────────────────────────────────────
# Webhook URL: https://your-railway-api.railway.app/webhooks/github
GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# ── GitHub Personal Access Token (for reading PR diffs) ──────────────────────
GITHUB_TOKEN="your-github-pat"

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get from: Upstash Console → Redis → Connect → ioredis
# MUST use rediss:// (TLS) for Upstash — NOT redis://
REDIS_URL="rediss://default:[PASSWORD]@[HOST].upstash.io:6379"

# ── App ───────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — do not hardcode in production
PORT=3001
NODE_ENV="development"
# Set to your Vercel frontend URL in production (no trailing slash)
FRONTEND_URL="http://localhost:3000"

# ── Stuck-assessment recovery ────────────────────────────────────────────────
# Hours after AI review before an unfinalized assessment is treated as stuck
# and the candidate is nudged (once). Default 2.
# STALE_SUBMISSION_HOURS=2
# How often the sweep runs, in ms. Default 1800000 (30 min).
# STALE_SWEEP_INTERVAL_MS=1800000

# ── Whisper transcript confidence ────────────────────────────────────────────
# Below this 0-1 threshold the spoken defence is NOT scored: it's routed to
# human review with no penalty, because low confidence means bad AUDIO (mic,
# noise, accent) rather than a bad answer. Raise it to send more cases to
# review, lower it to score more automatically. Tune against real recordings.
# WHISPER_MIN_CONFIDENCE=0.45

# ── Hidden-test (CI grader) dispatch ─────────────────────────────────────────
# GitHub PAT used to fire a repository_dispatch at the grader repo. Hidden-test
# grading is silently skipped (no-op) if unset.
# GRADER_DISPATCH_TOKEN="ghp_..."
# Default/fallback grader repo when a Codebase has no graderRepo of its own.
# GRADER_REPO="DevSimulate/novatech-grader"
# HMAC secret shared with the grader repo's callback signer
# (scripts/sign-and-callback.js there) and verified by verifyGraderSignature
# in lib/grader.ts here. Must match exactly on both sides.
# GRADER_WEBHOOK_SECRET="generate-a-long-random-string"

# ── Hidden-test (CI grader) scoring ──────────────────────────────────────────
# Master switch for letting hidden-test results move a score. OFF (default)
# means the grader callback still runs and stores its result, exactly as
# before — it only stops short of touching scoreTotal. Flip to "true" once a
# grader repo's suites (e.g. geoinsight-grader) have been validated against
# real candidate submissions.
# HIDDEN_TESTS_SCORING_ENABLED=false
# Score cap applied when a CRITICAL hidden test fails (never raises a score).
# HIDDEN_TEST_SCORE_CAP=45

# ── Admin ─────────────────────────────────────────────────────────────────────
# Shared secret for /admin/* (manual finalize, needs-attention list). Sent as
# the x-admin-key header. If unset, ALL admin endpoints return 503 — an unset
# secret must never mean "open". Use a long random value.
ADMIN_API_KEY="generate-a-long-random-string"

# ── Hiring appeals ────────────────────────────────────────────────────────────
# Hiring candidates never see a result page, so the "request human review" link
# lives in the rejection/feedback email. This is the appeal window (days from
# that email) and the address the review request is directed to.
# APPEAL_WINDOW_DAYS=7
# REVIEW_CONTACT_EMAIL=ossama@devsimulate.com

# Reply address printed in the assessment INVITE (candidate questions, and the
# "delete my data" request). Falls back to REVIEW_CONTACT_EMAIL if unset. Set it
# per client — for a hiring pilot this should be a person at the hiring company,
# not DevSimulate, or candidates write to the wrong company about their data.
ASSESSMENT_CONTACT_EMAIL=ossama@lmkr.com

# ── Invite reminders ──────────────────────────────────────────────────────────
# Invited candidates who never open the assessment are nudged on this cadence
# until they start or the campaign deadline passes. Runs inside the stale-sweep
# worker (see STALE_SWEEP_INTERVAL_MS for how often it checks).
# MAX is a safety cap so a campaign saved without a deadline can't nudge forever.
# INVITE_REMINDER_DAYS=2
# INVITE_MAX_REMINDERS=5

# Resend webhook signing secret (Svix). Configure a webhook in the Resend
# dashboard pointing at POST /webhooks/resend and paste its secret here so
# delivery status (delivered/bounced/complained) advances. Without it, sends
# still record as SENT but statuses never progress.
# RESEND_WEBHOOK_SECRET=whsec_...

# ── Typed-defence fallback ────────────────────────────────────────────────────
# When a mic genuinely fails, the spoken defence falls back to a typed one —
# granted ONLY by these server-observed triggers or an admin, never by the
# candidate. Garbled pre-flight clips before it's offered; low-confidence spoken
# answers before it's offered; and the hard per-answer typing timer (seconds).
# TYPED_DEFENCE_PREFLIGHT_FAILS=3
# TYPED_DEFENCE_LOWCONF_HITS=2
# TYPED_DEFENCE_ANSWER_SECONDS=300

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
